# ==============================================================================
# RAHILA KAREEM • PORTFOLIO & CLIENT WORKSPACE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Copy this file to .env for local development.
# For Vercel Production: Add these key-value pairs in Vercel Project Settings -> Environment Variables.

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=production

# 2. CORS & CLIENT SECURITY
# Allowed frontend client origin (e.g., https://your-portfolio.vercel.app or http://localhost:5173)
CLIENT_URL=https://your-portfolio.vercel.app

# 3. JWT AUTHENTICATION SECRET
# Generate a strong, cryptographically secure 64-byte random string for signing session tokens
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters_here

# 4. REAL EMAIL OWNERSHIP VERIFICATION (NODEMAILER SMTP)
# Used to dispatch real single-use 6-digit OTP verification codes to registering clients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=wordpressrahila@gmail.com
# Gmail 16-character App Password (generated via Google Account -> Security -> 2-Step Verification -> App passwords)
# NOTE: Do NOT use standard Gmail password. Use 16-character App Password without spaces.
EMAIL_PASS=your_16_character_gmail_app_password

# 5. MONGODB ATLAS DATABASE URI
# Production MongoDB Atlas connection string. Replace <db_password> with your actual MongoDB Atlas user password.
# Example format:
# mongodb+srv://rahilakareem389_db_user:<db_password>@cluster0.8uahp7y.mongodb.net/rahila_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://rahilakareem389_db_user:<db_password>@cluster0.8uahp7y.mongodb.net/rahila_portfolio?retryWrites=true&w=majority

# 6. WEB3FORMS ACCESS KEY (FOR CONTACT FORM INQUIRIES ONLY)
# Dedicated Web3Forms access key registered for contact form submissions:
WEB3FORMS_ACCESS_KEY=ad131140-827b-407f-a476-5afd66b1fa0b
